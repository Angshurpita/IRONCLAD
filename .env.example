# Ironclad Configuration Template
# Copy this file to .env and provide your credentials.

# Inference Provider: 'openrouter' or 'ollama'
IRONCLAD_INFERENCE_PROVIDER=openrouter

# OpenRouter Configuration (Hosted Inference)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-26b-a4b

# Ollama Configuration (Local Inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b

# Embedding Configuration (Local)
IRONCLAD_EMBEDDING_PROVIDER=local
IRONCLAD_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Knowledge Base & Retrieval Settings
IRONCLAD_DIR=.ironclad
IRONCLAD_MAX_FILE_SIZE_BYTES=10485760
IRONCLAD_CHUNK_SIZE=500
IRONCLAD_CHUNK_OVERLAP=50
IRONCLAD_MAX_CONTEXT_TOKENS=4000
IRONCLAD_LOG_LEVEL=INFO
